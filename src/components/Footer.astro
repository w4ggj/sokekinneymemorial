---

<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-top">

      <div class="footer-org">
        <p class="footer-org-name">Soke Kinney Memorial Fund</p>
        <!-- Office/contact address — where people write or visit -->
        <address class="footer-address">
          6701 49th St N<br />
          Pinellas Park, FL 33781<br />
          <a href="tel:+17276860864">727-686-0864</a><br />
          <a href="mailto:sokekinneymemorialfund@gmail.com">sokekinneymemorialfund@gmail.com</a>
        </address>
        <p class="footer-legal">EIN 81-2108510 &middot; 501&#40;c&#41;&#40;3&#41; nonprofit</p>
        <!-- TODO: Registered/legal address (7627 Par Avenue North, St. Petersburg, FL 33710)
             is used on donation receipts and tax language. Update once registration change
             to the Pinellas Park address is complete. -->
      </div>

      <nav class="footer-nav" aria-label="Footer links">
        <ul role="list">
          <li>
            <a href="https://www.facebook.com/SokeKinneyMemorialFund" rel="noopener noreferrer" target="_blank">
              Facebook
            </a>
          </li>
          <li>
            <a href="/donate">Donate</a>
          </li>
          <li class="footer-school">
            <a href="https://kinneykarate.com" rel="noopener noreferrer" target="_blank">
              The school he founded<br />
              <span class="footer-school-name">kinneykarate.com</span>
            </a>
          </li>
        </ul>
      </nav>

    </div>

    <div class="footer-bottom">
      <p>&copy; {new Date().getFullYear()} Soke Kinney Memorial Fund. All rights reserved.</p>
      <p class="footer-dev">Developed by <a href="https://tavaone.com/#dev" class="footer-dev-link" rel="noopener noreferrer" target="_blank">Tava One LLC</a></p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background-color: var(--ink);
    color: var(--text-invert);
    padding-block: 4rem;
  }

  .footer-inner {
    max-width: 1200px;
    margin-inline: auto;
    padding-inline: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }

  .footer-top {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 3rem;
    align-items: start;
  }

  /* Org block */
  .footer-org-name {
    font-family: 'Space Mono', 'Courier New', monospace;
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--gold);
    margin-bottom: 0.75rem;
  }

  .footer-address {
    font-style: normal;
    font-family: 'Barlow', system-ui, sans-serif;
    font-size: 0.9375rem;
    line-height: 1.7;
    color: rgba(244, 242, 236, 0.8);
  }

  .footer-address a {
    color: inherit;
    text-decoration: none;
  }

  .footer-address a:hover,
  .footer-address a:focus-visible {
    color: var(--text-invert);
  }

  .footer-legal {
    margin-top: 0.75rem;
    font-family: 'Barlow', system-ui, sans-serif;
    font-size: 0.8125rem;
    color: rgba(244, 242, 236, 0.5);
  }

  /* Nav block */
  .footer-nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    text-align: right;
  }

  .footer-nav a {
    color: rgba(244, 242, 236, 0.8);
    text-decoration: none;
    font-family: 'Barlow', system-ui, sans-serif;
    font-size: 0.9375rem;
    transition: color 150ms ease;
  }

  .footer-nav a:hover,
  .footer-nav a:focus-visible {
    color: var(--text-invert);
  }

  .footer-school a {
    line-height: 1.5;
  }

  .footer-school-name {
    display: block;
    font-family: 'Barlow', system-ui, sans-serif;
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--text-invert);
  }

  /* Bottom bar */
  .footer-bottom {
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    padding-top: 1.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .footer-bottom p {
    font-family: 'Barlow', system-ui, sans-serif;
    font-size: 0.8125rem;
    color: rgba(244, 242, 236, 0.4);
  }

  .footer-dev-link {
    color: rgba(244, 242, 236, 0.4);
    text-decoration: none;
    transition: color 150ms ease;
  }

  .footer-dev-link:hover,
  .footer-dev-link:focus-visible {
    color: rgba(244, 242, 236, 0.7);
  }

  @media (max-width: 600px) {
    .footer-top {
      grid-template-columns: 1fr;
    }
    .footer-nav ul {
      text-align: left;
    }
    .footer-bottom {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.5rem;
    }
  }

  @media (max-width: 400px) {
    .footer-inner {
      padding-inline: 1rem;
    }
  }
</style>

---
/**
 * RecordImage — archival photo record per §4.5
 *
 * Image is capped at native pixel dimensions; never upscaled.
 * Caption plate: Space Mono, --text-soft on --paper-2, hairline --line rule above.
 * Any of year / location / source may be omitted.
 * If all three are omitted, plate reads "DATE UNKNOWN".
 */
interface Props {
  src: string;
  alt: string;
  nativeWidth: number;
  nativeHeight: number;
  year?: string;
  location?: string;
  source?: string;
  class?: string;
}

const {
  src,
  alt,
  nativeWidth,
  nativeHeight,
  year,
  location,
  source,
  class: className = '',
} = Astro.props;

const dateParts = [year, location].filter(Boolean);
const line1 = dateParts.length > 0 ? dateParts.join(' · ') : 'DATE UNKNOWN';
const line2 = source ? `SOURCE: ${source.toUpperCase()}` : null;
---

<figure class={`record ${className}`} style={`max-width: ${nativeWidth}px;`}>
  <div class="record-frame">
    <img
      src={src}
      alt={alt}
      width={nativeWidth}
      height={nativeHeight}
      loading="lazy"
      decoding="async"
    />
  </div>
  <figcaption class="record-caption">
    <span>{line1}</span>
    {line2 && <span>{line2}</span>}
  </figcaption>
</figure>

<style>
  .record {
    width: 100%;
    /* max-width set inline to native pixel width — enforces never-upscale */
  }

  .record-frame {
    border: 1px solid var(--line);
    border-bottom: none;
    line-height: 0;
  }

  .record-frame img {
    width: 100%;
    height: auto;
    display: block;
  }

  .record-caption {
    background-color: var(--paper-2);
    border: 1px solid var(--line);
    border-top: 1px solid var(--line); /* hairline rule */
    padding: 0.5rem 0.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    margin: 0;
    font-family: 'Space Mono', 'Courier New', monospace;
    font-size: 0.8125rem;
    letter-spacing: 0.02em;
    line-height: 1.5;
    color: var(--text-soft);
  }
</style>

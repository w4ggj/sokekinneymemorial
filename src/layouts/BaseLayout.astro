---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Soke Kinney Memorial Fund',
  description = 'The Soke Kinney Memorial Fund honors the legacy of Soke Michael Kinney — martial artist, teacher, and community leader — through scholarship and education.',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content="Soke Kinney Memorial Fund" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
  </head>
  <body>
    <a href="#main-content" class="skip-link visually-hidden">Skip to main content</a>

    <header class="site-header">
      <div class="wide-spine site-header__inner">
        <a href="/" class="wordmark" aria-label="Soke Kinney Memorial Fund — home">
          <span class="wordmark__ring" aria-hidden="true">◎</span>
          <span class="wordmark__text">Soke Kinney<br />Memorial Fund</span>
        </a>

        <nav aria-label="Primary navigation">
          <ul class="nav-list" role="list">
            <li><a href="/story">His Story</a></li>
            <li><a href="/team">Our Instructors</a></li>
            <li><a href="/events">Events</a></li>
            <li><a href="/sponsors">Partners</a></li>
            <li><a href="/contact">Contact</a></li>
            <li><a href="/donate" class="nav-donate">Donate</a></li>
          </ul>
        </nav>

        <button class="nav-toggle" aria-controls="mobile-nav" aria-expanded="false" aria-label="Open navigation menu">
          <span></span><span></span><span></span>
        </button>
      </div>

      <nav id="mobile-nav" class="mobile-nav" aria-label="Mobile navigation" hidden>
        <ul role="list">
          <li><a href="/story">His Story</a></li>
          <li><a href="/team">Our Instructors</a></li>
          <li><a href="/events">Events</a></li>
          <li><a href="/sponsors">Partners</a></li>
          <li><a href="/contact">Contact</a></li>
          <li><a href="/donate">Donate</a></li>
        </ul>
      </nav>
    </header>

    <main id="main-content">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wide-spine site-footer__inner">
        <div class="site-footer__top">
          <div class="site-footer__org">
            <p class="type-eyebrow" style="color: var(--gold); margin-bottom: var(--space-3);">Soke Kinney Memorial Fund</p>
            <address style="font-style: normal; color: var(--text-invert); opacity: 0.8; font-size: 0.9375rem; line-height: 1.7;">
              7627 Par Avenue North<br />
              St. Petersburg, FL 33710<br />
              <a href="tel:+17276860864" style="color: inherit;">727-686-0864</a><br />
              <a href="mailto:sokekinneymemorialfund@gmail.com" style="color: inherit;">sokekinneymemorialfund@gmail.com</a>
            </address>
            <p style="color: var(--text-invert); opacity: 0.6; font-size: 0.8125rem; margin-top: var(--space-3);">
              EIN 81-2108510 &middot; 501(c)(3) nonprofit
            </p>
          </div>

          <nav class="site-footer__links" aria-label="Footer navigation">
            <ul role="list">
              <li><a href="https://www.facebook.com/SokeKinneyMemorialFund" rel="noopener noreferrer" target="_blank">Facebook</a></li>
              <li><a href="/donate">Donate</a></li>
              <li>
                <a href="https://kinneykarate.com" rel="noopener noreferrer" target="_blank" class="site-footer__school-link">
                  The school he founded<br />
                  <span style="font-family: 'Barlow', sans-serif; font-weight: 600;">kinneykarate.com</span>
                </a>
              </li>
            </ul>
          </nav>
        </div>

        <div class="site-footer__bottom">
          <p style="color: var(--text-invert); opacity: 0.45; font-size: 0.8125rem;">
            &copy; {new Date().getFullYear()} Soke Kinney Memorial Fund. All rights reserved.
          </p>
        </div>
      </div>
    </footer>

    <script>
      // Scroll-reveal
      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry, i) => {
          if (entry.isIntersecting) {
            const el = entry.target as HTMLElement;
            const delay = el.dataset.delay ? parseInt(el.dataset.delay) : 0;
            setTimeout(() => el.classList.add('visible'), delay);
            observer.unobserve(el);
          }
        });
      }, { threshold: 0.1 });

      document.querySelectorAll('.fade-rise').forEach((el) => observer.observe(el));

      // Mobile nav toggle
      const toggle = document.querySelector('.nav-toggle') as HTMLButtonElement;
      const mobileNav = document.getElementById('mobile-nav') as HTMLElement;

      toggle?.addEventListener('click', () => {
        const expanded = toggle.getAttribute('aria-expanded') === 'true';
        toggle.setAttribute('aria-expanded', String(!expanded));
        mobileNav.hidden = expanded;
      });
    </script>
  </body>
</html>

<style>
  .skip-link:focus {
    position: fixed;
    top: var(--space-4);
    left: var(--space-4);
    z-index: 999;
    background: var(--crimson);
    color: var(--text-invert);
    padding: var(--space-2) var(--space-4);
    border-radius: var(--r);
    text-decoration: none;
    font-family: 'Barlow', sans-serif;
    font-weight: 600;
    clip: auto;
    width: auto;
    height: auto;
    white-space: nowrap;
  }

  /* ─── Header ──────────────────────────────────────────────── */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background-color: var(--paper);
    border-bottom: 1px solid var(--line);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    gap: var(--space-8);
    padding-block: var(--space-4);
  }

  /* Wordmark */
  .wordmark {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    text-decoration: none;
    color: var(--text);
    flex-shrink: 0;
  }

  .wordmark__ring {
    font-size: 1.75rem;
    color: var(--crimson);
    line-height: 1;
    user-select: none;
  }

  .wordmark__text {
    font-family: 'Newsreader Variable', 'Newsreader', Georgia, serif;
    font-size: 1.0625rem;
    font-weight: 400;
    line-height: 1.25;
    color: var(--text);
  }

  /* Desktop nav */
  .nav-list {
    display: flex;
    align-items: center;
    gap: var(--space-6);
    list-style: none;
    margin: 0;
    padding: 0;
    margin-left: auto;
  }

  .nav-list a {
    text-decoration: none;
    color: var(--text-soft);
    font-family: 'Barlow', sans-serif;
    font-size: 0.9375rem;
    font-weight: 500;
    transition: color 150ms ease;
  }

  .nav-list a:hover,
  .nav-list a:focus-visible {
    color: var(--text);
  }

  .nav-donate {
    color: var(--crimson) !important;
    font-weight: 600 !important;
  }

  .nav-donate:hover,
  .nav-donate:focus-visible {
    color: var(--crimson-deep) !important;
  }

  /* Hamburger */
  .nav-toggle {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: var(--space-2);
    margin-left: auto;
  }

  .nav-toggle span {
    display: block;
    width: 24px;
    height: 2px;
    background-color: var(--text);
  }

  /* Mobile nav */
  .mobile-nav {
    border-top: 1px solid var(--line);
    padding: var(--space-4) var(--space-6);
  }

  .mobile-nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .mobile-nav a {
    text-decoration: none;
    color: var(--text);
    font-family: 'Barlow', sans-serif;
    font-size: 1rem;
    font-weight: 500;
  }

  @media (max-width: 768px) {
    .nav-list { display: none; }
    .nav-toggle { display: flex; }
  }

  /* ─── Footer ──────────────────────────────────────────────── */
  .site-footer {
    background-color: var(--ink);
    color: var(--text-invert);
    padding-block: var(--space-16);
  }

  .site-footer__inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-12);
  }

  .site-footer__top {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: var(--space-12);
    align-items: start;
  }

  .site-footer__links ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    text-align: right;
  }

  .site-footer__links a {
    color: var(--text-invert);
    text-decoration: none;
    opacity: 0.8;
    font-family: 'Barlow', sans-serif;
    font-size: 0.9375rem;
    transition: opacity 150ms ease;
  }

  .site-footer__links a:hover,
  .site-footer__links a:focus-visible {
    opacity: 1;
  }

  .site-footer__school-link {
    font-family: 'Space Mono', monospace !important;
    font-size: 0.75rem !important;
    letter-spacing: 0.05em;
    line-height: 1.5;
  }

  .site-footer__bottom {
    border-top: 1px solid rgba(255,255,255,0.1);
    padding-top: var(--space-6);
  }

  @media (max-width: 600px) {
    .site-footer__top {
      grid-template-columns: 1fr;
    }

    .site-footer__links ul {
      text-align: left;
    }
  }
</style>

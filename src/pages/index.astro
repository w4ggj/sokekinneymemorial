---
import Base from '../layouts/Base.astro';
import RecordImage from '../components/RecordImage.astro';

// Impact figures — owner populates when verified numbers exist (§10 item 2).
// Empty array = section does not render at all.
const impactFigures: { value: string; label: string }[] = [];
---

<Base
  title="Soke Kinney Memorial Fund"
  description="Honoring the life and legacy of Soke Michael Kinney — martial artist, teacher, and community leader — through scholarship and education in St. Petersburg, Florida."
>

  <!-- ── Hero ──────────────────────────────────────────────── -->
  <!-- No photograph in the hero — see §9.1 and §5.1 -->
  <section class="hero" aria-label="Memorial hero">
    <div class="hero-inner">
      <img
        src="/patch_hero.png"
        alt="Soke Kinney Memorial Fund commemorative patch"
        class="hero-patch"
        width="260"
        height="260"
      />
      <div class="hero-text">
        <p class="hero-eyebrow">Soke Kinney Memorial Fund</p>
        <h1 class="hero-name">Soke Michael Kinney</h1>
        <p class="hero-dates">1952 – 2014</p>
      </div>
    </div>
  </section>

  <!-- ── In memoriam ───────────────────────────────────────── -->
  <section class="section memoriam" aria-labelledby="memoriam-heading">
    <div class="wide-inner">
      <div class="memoriam-portrait fade-rise" data-delay="0">
        <RecordImage
          src="/images/michael_kinney_logo.jpg"
          alt="Painted portrait of Soke Michael Kinney"
          nativeWidth={480}
          nativeHeight={600}
          source="Kinney Family"
        />
      </div>
      <div class="memoriam-copy fade-rise" data-delay="60">
        <p class="eyebrow" style="color: var(--crimson);">In memoriam</p>
        <h2 id="memoriam-heading" class="memoriam-heading">Soke Michael Kinney</h2>
        <p class="memoriam-dates">1952 – 2014</p>
        <div class="memoriam-bio">
          <p class="lede">
            Soke Michael Kinney devoted over fifty years to the martial arts and to the
            communities they could reach. He trained under Grand Master Ki Whang Kim
            in Silver Spring, Maryland, earned the first Tang Soo Do Karate Association
            black belt in 1969, and spent the decades that followed building one of the
            most enduring programs in American martial arts history.
          </p>
          <p class="body-copy">
            When he moved to St. Petersburg in 1980, he turned a small back room offered
            by the city Recreation Department into a decades-long partnership — a city-wide
            program that touched tens of thousands of lives and was credited, in part, with
            helping St. Petersburg earn a national All-American City award.
          </p>
          <p class="body-copy">
            He died October 6, 2014, at age 62. This fund carries his name and his work forward.
          </p>
        </div>
        <a href="/story" class="btn-secondary">Read his story</a>
      </div>
    </div>
  </section>

  <!-- ── Mission ───────────────────────────────────────────── -->
  <section class="section mission" aria-labelledby="mission-heading">
    <div class="content-inner">
      <p class="eyebrow fade-rise" data-delay="0" style="color: var(--crimson);">Our mission</p>
      <h2 id="mission-heading" class="section-heading fade-rise" data-delay="60">
        Continuing the work he started
      </h2>
      <div class="mission-body">
        <p class="body-copy fade-rise" data-delay="120">
          The Soke Kinney Memorial Fund is a 501&#40;c&#41;&#40;3&#41; nonprofit organization established
          to honor the legacy of Soke Michael Kinney by providing scholarships and
          financial assistance to students who wish to study the martial arts but lack
          the means to do so.
        </p>
        <p class="body-copy fade-rise" data-delay="180">
          Soke Kinney believed that the discipline, respect, and confidence the martial
          arts cultivate belong to every child who wants them — not only those whose
          families can afford tuition. The fund exists to make that belief real, year
          after year, in the community where he spent the last thirty years of his life.
        </p>
      </div>
    </div>
  </section>

  <!-- ── Impact — renders only when figures are available ──── -->
  {impactFigures.length > 0 && (
    <section class="section impact" aria-labelledby="impact-heading">
      <div class="wide-inner">
        <p class="eyebrow" style="color: var(--gold);">Impact</p>
        <h2 id="impact-heading" class="visually-hidden">Fund impact</h2>
        <ul class="impact-figures" role="list">
          {impactFigures.map((fig, i) => (
            <li class="impact-figure fade-rise" data-delay={String(i * 60)}>
              <span class="impact-value">{fig.value}</span>
              <span class="impact-label">{fig.label}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <!-- ── Upcoming events (stub — calendar Worker built in Phase 2) ── -->
  <!--
    <section class="section events" aria-labelledby="events-heading">
      Next 3 events from the calendar Worker — see §5.1 and §5.4
    </section>
  -->

  <!-- ── Donate CTA ─────────────────────────────────────────── -->
  <section class="section donate-cta" aria-labelledby="cta-heading">
    <div class="content-inner cta-inner fade-rise">
      <p class="eyebrow" style="color: var(--crimson);">Support the fund</p>
      <h2 id="cta-heading" class="section-heading">Help us keep his work alive</h2>
      <p class="lede" style="color: var(--text-soft);">
        A gift to the Soke Kinney Memorial Fund goes directly to scholarship support
        for students in St. Petersburg, Florida.
      </p>
      <a href="/donate" class="btn-primary">Donate now</a>
    </div>
  </section>

</Base>

<style>
  /* ── Layout helpers ────────────────────────────────────────── */
  .wide-inner {
    max-width: 1200px;
    margin-inline: auto;
    padding-inline: 1.5rem;
  }

  .content-inner {
    max-width: 68ch;
    margin-inline: auto;
    padding-inline: 1.5rem;
  }

  /* ── Type helpers (local) ──────────────────────────────────── */
  .eyebrow {
    font-family: 'Space Mono', 'Courier New', monospace;
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    margin-bottom: 1rem;
    display: block;
  }

  .section-heading {
    font-family: 'Newsreader Variable', 'Newsreader', Georgia, serif;
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    font-weight: 400;
    line-height: 1.2;
    margin-bottom: 2rem;
    color: var(--text);
  }

  .lede {
    font-family: 'Newsreader Variable', 'Newsreader', Georgia, serif;
    font-size: clamp(1.15rem, 1.6vw, 1.35rem);
    font-weight: 300;
    line-height: 1.6;
    margin-bottom: 1.5rem;
    color: var(--text);
  }

  .body-copy {
    font-family: 'Barlow', system-ui, sans-serif;
    font-size: 1.0625rem;
    line-height: 1.7;
    color: var(--text);
  }

  /* ── Sections ──────────────────────────────────────────────── */
  .section {
    padding-block: 5rem;
  }

  /* ── Hero ──────────────────────────────────────────────────── */
  .hero {
    background-color: var(--ink);
    padding-block: 5rem;
  }

  .hero-inner {
    max-width: 1200px;
    margin-inline: auto;
    padding-inline: 1.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2rem;
    text-align: center;
  }

  .hero-patch {
    width: 260px;
    height: 260px;
    flex-shrink: 0;
  }

  .hero-eyebrow {
    font-family: 'Space Mono', 'Courier New', monospace;
    font-size: 0.75rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgba(244, 242, 236, 0.5);
    margin-bottom: 0.5rem;
  }

  .hero-name {
    font-family: 'Newsreader Variable', 'Newsreader', Georgia, serif;
    font-size: clamp(2.25rem, 4.5vw, 3.5rem);
    font-weight: 400;
    color: var(--text-invert);
    line-height: 1.1;
    margin-bottom: 0.75rem;
  }

  .hero-dates {
    font-family: 'Space Mono', 'Courier New', monospace;
    font-size: 0.9rem;
    letter-spacing: 0.2em;
    color: var(--gold);
  }

  /* ── In memoriam ───────────────────────────────────────────── */
  .memoriam {
    background-color: var(--paper-2);
    border-bottom: 1px solid var(--line);
  }

  .memoriam .wide-inner {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 4rem;
    align-items: start;
  }

  .memoriam-portrait {
    /* RecordImage handles its own max-width cap */
  }

  .memoriam-heading {
    font-family: 'Newsreader Variable', 'Newsreader', Georgia, serif;
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    font-weight: 400;
    color: var(--text);
    line-height: 1.2;
    margin-bottom: 0.25rem;
  }

  .memoriam-dates {
    font-family: 'Space Mono', 'Courier New', monospace;
    font-size: 0.875rem;
    color: var(--text-soft);
    letter-spacing: 0.08em;
    margin-bottom: 1.75rem;
  }

  .memoriam-bio {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: 2rem;
  }

  /* ── Mission ───────────────────────────────────────────────── */
  .mission-body {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  /* ── Impact ────────────────────────────────────────────────── */
  .impact {
    background-color: var(--ink);
  }

  .impact-figures {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: 4rem;
    flex-wrap: wrap;
    margin-top: 1.5rem;
  }

  .impact-figure {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .impact-value {
    font-family: 'Newsreader Variable', 'Newsreader', Georgia, serif;
    font-size: clamp(2.75rem, 6vw, 5rem);
    font-weight: 400;
    letter-spacing: -0.02em;
    line-height: 1;
    color: var(--text-invert);
  }

  .impact-label {
    font-family: 'Space Mono', 'Courier New', monospace;
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--gold);
  }

  /* ── Donate CTA ────────────────────────────────────────────── */
  .donate-cta {
    border-top: 1px solid var(--line);
  }

  .cta-inner {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  /* ── Buttons ───────────────────────────────────────────────── */
  .btn-primary {
    display: inline-block;
    background-color: var(--crimson);
    color: var(--text-invert);
    font-family: 'Barlow', system-ui, sans-serif;
    font-size: 1rem;
    font-weight: 600;
    padding: 0.8rem 2rem;
    border-radius: var(--r);
    text-decoration: none;
    transition: background-color 150ms ease;
  }

  .btn-primary:hover,
  .btn-primary:focus-visible {
    background-color: var(--crimson-deep);
  }

  .btn-secondary {
    display: inline-block;
    background-color: transparent;
    color: var(--crimson);
    font-family: 'Barlow', system-ui, sans-serif;
    font-size: 1rem;
    font-weight: 600;
    padding: 0.75rem 2rem;
    border-radius: var(--r);
    text-decoration: none;
    border: 2px solid var(--crimson);
    transition: background-color 150ms ease, color 150ms ease;
  }

  .btn-secondary:hover,
  .btn-secondary:focus-visible {
    background-color: var(--crimson);
    color: var(--text-invert);
  }

  /* ── Responsive ────────────────────────────────────────────── */
  @media (max-width: 768px) {
    .memoriam .wide-inner {
      grid-template-columns: 1fr;
    }

    .memoriam-portrait {
      max-width: 320px;
    }

    .impact-figures {
      gap: 2rem;
    }
  }

  /* 320px — smallest supported viewport (§12) */
  @media (max-width: 400px) {
    .hero {
      padding-block: 3rem;
    }

    .hero-patch {
      width: 200px;
      height: 200px;
    }

    .section {
      padding-block: 3rem;
    }

    .wide-inner,
    .content-inner {
      padding-inline: 1rem;
    }

    .memoriam .wide-inner {
      gap: 2rem;
    }

    .memoriam-portrait {
      max-width: 100%;
    }

    .btn-primary,
    .btn-secondary {
      width: 100%;
      text-align: center;
      padding-inline: 1rem;
    }
  }
</style>

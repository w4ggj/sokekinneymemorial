---
import Base from '../layouts/Base.astro';

// Current sponsors per §5.6. Only Alesia has a logo.
const sponsors = [
  {
    name: 'Alesia on Central',
    description: 'A valued community partner and supporter of the Soke Kinney Memorial Fund.',
    logo: null,
    url: 'https://www.alesiarestaurant.com/',
  },
  {
    name: 'The Pizza Joint',
    description: 'A proud community partner of the Soke Kinney Memorial Fund.',
    logo: null,
    url: 'https://www.thepizzajointfl.com/',
  },
  {
    name: 'Brez Coffee Co',
    description: 'A proud community partner of the Soke Kinney Memorial Fund.',
    logo: null,
    url: 'https://brezcoffeeco.com/',
  },
  {
    name: 'Trenam Kemker',
    description: 'A proud community partner of the Soke Kinney Memorial Fund.',
    logo: null,
    url: 'https://www.trenam.com/',
  },
  {
    name: 'John Spinks',
    description: 'A longtime supporter of the fund and the Kinney Karate community.',
    logo: null,
    url: null,
  },
  {
    name: 'James Pereboom',
    description: 'A generous individual supporter of the Soke Kinney Memorial Fund.',
    logo: null,
    url: null,
  },
  {
    name: 'Bellhops',
    description: 'A proud community partner of the Soke Kinney Memorial Fund.',
    logo: null,
    url: null,
  },
];
---

<Base
  title="Community Partners — Soke Kinney Memorial Fund"
  description="The businesses and individuals who support the Soke Kinney Memorial Fund and the scholarships it provides."
>

  <div class="page-hero">
    <div class="page-hero__inner">
      <p class="eyebrow">Community partners</p>
      <h1 class="page-title">Supporters of the fund</h1>
      <p class="page-lede">
        These organizations and individuals help make scholarship support possible for
        students across the St. Petersburg community. We are grateful for their partnership.
      </p>
    </div>
  </div>

  <section class="sponsors-section" aria-labelledby="sponsors-heading">
    <div class="sponsors-inner">
      <h2 id="sponsors-heading" class="section-eyebrow">Current partners</h2>
      <ul class="sponsor-grid" role="list">
        {sponsors.map((sponsor) => (
          <li class="sponsor-card fade-rise">
            {sponsor.logo ? (
              <div class="sponsor-card__logo">
                <img src={sponsor.logo} alt={sponsor.name} loading="lazy" />
              </div>
            ) : (
              <div class="sponsor-card__name-mark" aria-hidden="true">
                <span>{sponsor.name.charAt(0)}</span>
              </div>
            )}
            <div class="sponsor-card__body">
              <h3 class="sponsor-card__name">
                {sponsor.url ? (
                  <a href={sponsor.url} rel="noopener noreferrer" target="_blank">{sponsor.name}</a>
                ) : (
                  sponsor.name
                )}
              </h3>
              <p class="sponsor-card__description">{sponsor.description}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ── Become a sponsor ──────────────────────────────────── -->
  <section class="become-sponsor fade-rise" aria-labelledby="become-heading">
    <div class="become-sponsor__inner">
      <p class="eyebrow" style="color: var(--crimson);">Get involved</p>
      <h2 id="become-heading" class="become-sponsor__heading">Become a community partner</h2>
      <p class="become-sponsor__body">
        Sponsoring the Soke Kinney Memorial Fund connects your organization to a
        501&#40;c&#41;&#40;3&#41; nonprofit with deep roots in St. Petersburg.
        Your support goes directly to scholarships for students who want to train
        but lack the means to do so. We welcome partners of every size.
      </p>
      <a href="/contact" class="btn-primary">Get in touch</a>
    </div>
  </section>

</Base>

<style>
  /* ── Page hero ──────────────────────────────────────────── */
  .page-hero {
    background-color: var(--ink);
    padding-block: 4rem;
  }

  .page-hero__inner {
    max-width: 1200px;
    margin-inline: auto;
    padding-inline: 1.5rem;
  }

  .eyebrow {
    font-family: 'Space Mono', 'Courier New', monospace;
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(244, 242, 236, 0.5);
    margin-bottom: 0.75rem;
    display: block;
  }

  .page-title {
    font-family: 'Newsreader Variable', 'Newsreader', Georgia, serif;
    font-size: clamp(2.25rem, 4.5vw, 3.5rem);
    font-weight: 400;
    color: var(--text-invert);
    line-height: 1.1;
    margin-bottom: 1rem;
  }

  .page-lede {
    font-family: 'Newsreader Variable', 'Newsreader', Georgia, serif;
    font-size: clamp(1.1rem, 1.5vw, 1.25rem);
    font-weight: 300;
    color: rgba(244, 242, 236, 0.75);
    line-height: 1.6;
    max-width: 60ch;
  }

  /* ── Sponsors section ───────────────────────────────────── */
  .sponsors-section {
    padding-block: 4rem;
  }

  .sponsors-inner {
    max-width: 1200px;
    margin-inline: auto;
    padding-inline: 1.5rem;
  }

  .section-eyebrow {
    font-family: 'Space Mono', 'Courier New', monospace;
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-soft);
    margin-bottom: 2rem;
  }

  .sponsor-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.5rem;
  }

  /* ── Sponsor card ───────────────────────────────────────── */
  .sponsor-card {
    background-color: var(--paper);
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    padding: 2rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .sponsor-card__logo img {
    max-height: 60px;
    width: auto;
    object-fit: contain;
  }

  /* Name-only placeholder mark */
  .sponsor-card__name-mark {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background-color: var(--paper-2);
    border: 1px solid var(--line);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .sponsor-card__name-mark span {
    font-family: 'Newsreader Variable', 'Newsreader', Georgia, serif;
    font-size: 1.5rem;
    font-weight: 400;
    color: var(--text-soft);
    line-height: 1;
  }

  .sponsor-card__body {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .sponsor-card__name {
    font-family: 'Newsreader Variable', 'Newsreader', Georgia, serif;
    font-size: 1.2rem;
    font-weight: 500;
    color: var(--text);
    line-height: 1.2;
  }

  .sponsor-card__name a {
    color: var(--crimson);
    text-decoration: none;
  }

  .sponsor-card__name a:hover,
  .sponsor-card__name a:focus-visible {
    color: var(--crimson-deep);
  }

  .sponsor-card__description {
    font-family: 'Barlow', system-ui, sans-serif;
    font-size: 0.9375rem;
    line-height: 1.65;
    color: var(--text-soft);
  }

  /* ── Become a sponsor ───────────────────────────────────── */
  .become-sponsor {
    background-color: var(--paper-2);
    border-top: 1px solid var(--line);
    padding-block: 4rem;
  }

  .become-sponsor__inner {
    max-width: 68ch;
    margin-inline: auto;
    padding-inline: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .become-sponsor__heading {
    font-family: 'Newsreader Variable', 'Newsreader', Georgia, serif;
    font-size: clamp(1.5rem, 2.5vw, 2rem);
    font-weight: 400;
    color: var(--text);
    line-height: 1.2;
  }

  .become-sponsor__body {
    font-family: 'Barlow', system-ui, sans-serif;
    font-size: 1.0625rem;
    line-height: 1.7;
    color: var(--text);
  }

  .btn-primary {
    display: inline-block;
    align-self: flex-start;
    background-color: var(--crimson);
    color: var(--text-invert);
    font-family: 'Barlow', system-ui, sans-serif;
    font-size: 1rem;
    font-weight: 600;
    padding: 0.75rem 1.75rem;
    border-radius: var(--r);
    text-decoration: none;
    margin-top: 0.5rem;
    transition: background-color 150ms ease;
  }

  .btn-primary:hover,
  .btn-primary:focus-visible {
    background-color: var(--crimson-deep);
  }

  /* ── Responsive ─────────────────────────────────────────── */
  @media (max-width: 400px) {
    .page-hero__inner,
    .sponsors-inner,
    .become-sponsor__inner {
      padding-inline: 1rem;
    }
  }
</style>

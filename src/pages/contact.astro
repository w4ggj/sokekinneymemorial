---
import Base from '../layouts/Base.astro';

// Pre-select topic if ?topic=photos is in the URL (from /story photo invitation)
const topicParam = Astro.url.searchParams.get('topic') ?? '';
const preselect = topicParam === 'photos' ? 'photos' : '';
---

<Base
  title="Contact — Soke Kinney Memorial Fund"
  description="Get in touch with the Soke Kinney Memorial Fund. Questions, sponsorships, donations, or sharing photographs of Soke Kinney."
>

  <div class="page-hero">
    <div class="page-hero__inner">
      <p class="eyebrow">Contact us</p>
      <h1 class="page-title">Get in touch</h1>
    </div>
  </div>

  <div class="contact-layout">

    <section class="contact-form-section" aria-labelledby="form-heading">
      <h2 id="form-heading" class="visually-hidden">Contact form</h2>

      <!--
        Form UI only — submission logic (Worker → Resend) is Phase 3.
        action/method intentionally omitted; JS will handle in Phase 3.
      -->
      <form class="contact-form" novalidate aria-label="Contact form">

        <div class="field">
          <label for="contact-name" class="field__label">Your name <span class="field__required" aria-label="required">*</span></label>
          <input
            type="text"
            id="contact-name"
            name="name"
            class="field__input"
            autocomplete="name"
            required
            aria-required="true"
          />
        </div>

        <div class="field">
          <label for="contact-email" class="field__label">Email address <span class="field__required" aria-label="required">*</span></label>
          <input
            type="email"
            id="contact-email"
            name="email"
            class="field__input"
            autocomplete="email"
            required
            aria-required="true"
          />
        </div>

        <div class="field">
          <label for="contact-topic" class="field__label">Topic <span class="field__required" aria-label="required">*</span></label>
          <div class="field__select-wrap">
            <select
              id="contact-topic"
              name="topic"
              class="field__select"
              required
              aria-required="true"
            >
              <option value="" disabled selected={!preselect}>Select a topic</option>
              <option value="general" selected={preselect === 'general'}>General</option>
              <option value="donations" selected={preselect === 'donations'}>Donations</option>
              <option value="sponsorship" selected={preselect === 'sponsorship'}>Sponsorship</option>
              <option value="photos" selected={preselect === 'photos'}>Photos of Soke Kinney</option>
            </select>
            <span class="field__select-arrow" aria-hidden="true">▾</span>
          </div>
        </div>

        <div class="field">
          <label for="contact-message" class="field__label">Message <span class="field__required" aria-label="required">*</span></label>
          <textarea
            id="contact-message"
            name="message"
            class="field__textarea"
            rows="6"
            required
            aria-required="true"
          ></textarea>
        </div>

        <!-- Honeypot — hidden from real users, catches basic bots. Phase 3 adds Turnstile + rate limiting. -->
        <div class="field field--honeypot" aria-hidden="true">
          <label for="contact-website">Website (leave blank)</label>
          <input type="text" id="contact-website" name="website" tabindex="-1" autocomplete="off" />
        </div>

        <div class="form-footer">
          <button type="submit" class="btn-submit">Send message</button>
          <p class="form-note">
            Fields marked <span aria-hidden="true">*</span><span class="visually-hidden">with an asterisk</span> are required.
            We typically respond within two business days.
          </p>
        </div>

      </form>
    </section>

    <aside class="contact-info" aria-label="Contact information">
      <div class="contact-info__block">
        <p class="contact-info__label">Mailing address</p>
        <address class="contact-info__address">
          Soke Kinney Memorial Fund<br />
          7627 Par Avenue North<br />
          St. Petersburg, FL 33710
        </address>
      </div>

      <div class="contact-info__block">
        <p class="contact-info__label">Phone</p>
        <p><a href="tel:+17276860864" class="contact-info__link">727-686-0864</a></p>
      </div>

      <div class="contact-info__block">
        <p class="contact-info__label">Email</p>
        <p>
          <a href="mailto:sokekinneymemorialfund@gmail.com" class="contact-info__link contact-info__email">
            sokekinneymemorialfund@gmail.com
          </a>
        </p>
      </div>

      <div class="contact-info__block contact-info__photo-note">
        <p class="contact-info__label" style="color: var(--crimson);">Do you have photographs?</p>
        <p class="contact-info__copy">
          If you have photographs of Soke Kinney from any era — training, tournaments,
          ceremonies, or personal — we would be honored to hear from you. Select
          <strong>Photos of Soke Kinney</strong> as your topic.
        </p>
      </div>
    </aside>

  </div>

</Base>

<style>
  /* ── Page hero ──────────────────────────────────────────── */
  .page-hero {
    background-color: var(--ink);
    padding-block: 4rem;
  }

  .page-hero__inner {
    max-width: 1200px;
    margin-inline: auto;
    padding-inline: 1.5rem;
  }

  .eyebrow {
    font-family: 'Space Mono', 'Courier New', monospace;
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(244, 242, 236, 0.5);
    margin-bottom: 0.75rem;
    display: block;
  }

  .page-title {
    font-family: 'Newsreader Variable', 'Newsreader', Georgia, serif;
    font-size: clamp(2.25rem, 4.5vw, 3.5rem);
    font-weight: 400;
    color: var(--text-invert);
    line-height: 1.1;
  }

  /* ── Two-column layout ──────────────────────────────────── */
  .contact-layout {
    max-width: 1200px;
    margin-inline: auto;
    padding-inline: 1.5rem;
    padding-block: 4rem;
    display: grid;
    grid-template-columns: 1fr 320px;
    gap: 4rem;
    align-items: start;
  }

  /* ── Form ───────────────────────────────────────────────── */
  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .field__label {
    font-family: 'Barlow', system-ui, sans-serif;
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--text);
  }

  .field__required {
    color: var(--crimson);
    margin-left: 0.15em;
  }

  .field__input,
  .field__select,
  .field__textarea {
    font-family: 'Barlow', system-ui, sans-serif;
    font-size: 1rem;
    color: var(--text);
    background-color: var(--paper);
    border: 1px solid var(--line);
    border-radius: var(--r);
    padding: 0.625rem 0.875rem;
    width: 100%;
    transition: border-color 150ms ease, box-shadow 150ms ease;
    appearance: none;
    -webkit-appearance: none;
  }

  .field__input:focus,
  .field__select:focus,
  .field__textarea:focus {
    outline: none;
    border-color: var(--crimson);
    box-shadow: 0 0 0 3px rgba(160, 40, 33, 0.15);
  }

  .field__textarea {
    resize: vertical;
    min-height: 140px;
  }

  /* Custom select */
  .field__select-wrap {
    position: relative;
  }

  .field__select {
    padding-right: 2.5rem;
    cursor: pointer;
  }

  .field__select-arrow {
    position: absolute;
    right: 0.875rem;
    top: 50%;
    transform: translateY(-50%);
    pointer-events: none;
    color: var(--text-soft);
    font-size: 0.75rem;
  }

  /* Honeypot — visually and audibly hidden */
  .field--honeypot {
    position: absolute;
    left: -9999px;
    opacity: 0;
    height: 0;
    overflow: hidden;
  }

  .form-footer {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    flex-wrap: wrap;
    margin-top: 0.5rem;
  }

  .btn-submit {
    display: inline-block;
    background-color: var(--crimson);
    color: var(--text-invert);
    font-family: 'Barlow', system-ui, sans-serif;
    font-size: 1rem;
    font-weight: 600;
    padding: 0.8rem 2rem;
    border-radius: var(--r);
    border: none;
    cursor: pointer;
    transition: background-color 150ms ease;
    flex-shrink: 0;
  }

  .btn-submit:hover,
  .btn-submit:focus-visible {
    background-color: var(--crimson-deep);
  }

  .form-note {
    font-family: 'Barlow', system-ui, sans-serif;
    font-size: 0.875rem;
    color: var(--text-soft);
    line-height: 1.5;
  }

  /* ── Contact info sidebar ───────────────────────────────── */
  .contact-info {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    padding: 2rem;
    background-color: var(--paper-2);
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
  }

  .contact-info__block {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .contact-info__label {
    font-family: 'Space Mono', 'Courier New', monospace;
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-soft);
  }

  .contact-info__address {
    font-style: normal;
    font-family: 'Barlow', system-ui, sans-serif;
    font-size: 0.9375rem;
    line-height: 1.7;
    color: var(--text);
  }

  .contact-info__link {
    font-family: 'Barlow', system-ui, sans-serif;
    font-size: 0.9375rem;
    color: var(--crimson);
    text-decoration: none;
  }

  .contact-info__link:hover,
  .contact-info__link:focus-visible {
    color: var(--crimson-deep);
    text-decoration: underline;
  }

  .contact-info__email {
    word-break: break-all;
  }

  .contact-info__photo-note {
    border-top: 1px solid var(--line);
    padding-top: 1.5rem;
  }

  .contact-info__copy {
    font-family: 'Barlow', system-ui, sans-serif;
    font-size: 0.9rem;
    line-height: 1.65;
    color: var(--text);
  }

  /* ── Utilities ──────────────────────────────────────────── */
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0,0,0,0);
    white-space: nowrap;
    border: 0;
  }

  /* ── Responsive ─────────────────────────────────────────── */
  @media (max-width: 900px) {
    .contact-layout {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
  }

  @media (max-width: 400px) {
    .page-hero__inner,
    .contact-layout {
      padding-inline: 1rem;
    }

    .btn-submit {
      width: 100%;
    }
  }
</style>
